# Cloudinary (image uploads)
# Use either CLOUDINARY_URL or the three separate values below.
# Fix duplicate prefix if present: use cloudinary://key:secret@cloud_name only
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Base folder; vendor assets go under {folder}/vendors/{restaurant-slug}/logo|cover|menu
CLOUDINARY_UPLOAD_FOLDER=fast_bites/restaurants

# LLM for catalog OCR + category mapping (switch freely)
LLM_PROVIDER=groq
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
